import XCTest
import Combine
import CgmKit
import CgmFoundation
@testable import G7

// MARK: - Seeded Random Number Generator

struct SeededRandomNumberGenerator: RandomNumberGenerator {
    private var state: UInt64

    init(seed: UInt64) {
        self.state = seed
    }

    mutating func next() -> UInt64 {
        // xorshift64 — simple, fast, reproducible
        state ^= state << 13
        state ^= state >> 7
        state ^= state << 17
        return state
    }
}

// MARK: - Snapshot Test Helper

/// Shared helper for SnapshotAggregatorTests and SnapshotAggregatorBlockingTests.
/// Owns the seeded RNG and the race-free awaitSnapshot pattern.
///
/// A new random seed is generated per-test (via setUp) so:
/// - Every test run produces different EGV values → good coverage
/// - When CI fails the seed is printed and embedded in the failure message → fully reproducible
final class SnapshotTestHelper {

    // MARK: - Properties

    private let snapshotAggregator: SnapshotAggregatorManager
    private let subscriptions: AtomicSet<AnyCancellable>
    private var rng: SeededRandomNumberGenerator
    let seed: UInt64

    // MARK: - Init

    init(
        snapshotAggregator: SnapshotAggregatorManager,
        subscriptions: AtomicSet<AnyCancellable>
    ) {
        let seed = UInt64.random(in: 1..<UInt64.max)
        self.seed = seed
        self.snapshotAggregator = snapshotAggregator
        self.subscriptions = subscriptions
        self.rng = SeededRandomNumberGenerator(seed: seed)
        print("🌱 SnapshotTestHelper seed: \(seed) — pass to reproduce failures")
    }

    // MARK: - Random Value Helpers

    func randomEGV() -> UInt {
        UInt.random(in: 40..<400, using: &rng)
    }

    func randomRate() -> Double {
        Double.random(in: -8...8, using: &rng)
    }

    // MARK: - Await Snapshot

    /// Race-free async snapshot assertion helper.
    ///
    /// Subscribes to `$snapshotUpdated` BEFORE firing the trigger so no
    /// PassthroughSubject emission can be missed. The predicate must match
    /// the exact final state you expect — loose guards cause spurious fulfills.
    ///
    /// - Parameters:
    ///   - description: Human-readable label shown in failure output.
    ///   - timeout: Seconds before XCTFail is called. Default 10.
    ///   - trigger: State-change closure fired on MainActor after subscription is live.
    ///   - predicate: Return true only when the snapshot represents the expected final state.
    @discardableResult
    func awaitSnapshot(
        description: String = "",
        timeout: TimeInterval = 10.0,
        file: StaticString = #file,
        line: UInt = #line,
        trigger: (() -> Void)? = nil,
        predicate: @escaping (SecondaryDisplaySnapshot) -> Bool
    ) async -> SecondaryDisplaySnapshot? {

        var result: SecondaryDisplaySnapshot?
        let expectation = XCTestExpectation(description: description)
        expectation.assertForOverFulfill = true

        // Subscribe FIRST — PassthroughSubject has no replay.
        // The subscription must be live before any trigger fires.
        snapshotAggregator.$snapshotUpdated
            .first(where: predicate)
            .sink { snapshot in
                result = snapshot
                expectation.fulfill()
            }
            .store(in: &subscriptions)

        // Trigger on MainActor — writeSnapshot and displayState.send expect main thread.
        await MainActor.run {
            trigger?()
        }

        await XCTWaiter().fulfillment(of: [expectation], timeout: timeout)

        if result == nil {
            XCTFail(
                """
                [\(description)] awaitSnapshot timed out after \(timeout)s — \
                predicate never matched any emission.
                Seed to reproduce: \(seed)
                """,
                file: file,
                line: line
            )
        }

        return result
    }
}
